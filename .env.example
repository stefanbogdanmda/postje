# Auth.js — signs session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET=your-secret-here

# Resend — API key for sending magic link emails
AUTH_RESEND_KEY=re_your_key_here

# Admin bootstrap — email address for the admin account
ADMIN_EMAIL=admin@example.com

# Email sender address — use Resend default for dev, socialai.nl for production
EMAIL_FROM=onboarding@resend.dev
