# Auth.js — signs session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET=your-secret-here

# Resend — API key for sending magic link emails
AUTH_RESEND_KEY=re_your_key_here

# Admin bootstrap — email address for the admin account
ADMIN_EMAIL=admin@example.com

# Email sender address — use Resend default for dev, socialai.nl for production
EMAIL_FROM=onboarding@resend.dev

# Anthropic API — Claude SDK for post generation
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Vercel Blob storage
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxx

# Cron job authentication — Vercel injects Authorization: Bearer <CRON_SECRET>
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Base URL used when composing alert email links.
# Local: http://localhost:3000
# Production: https://your-domain.com (set in Vercel project settings)
NEXT_PUBLIC_APP_URL=http://localhost:3000
