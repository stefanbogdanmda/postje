# ============================================================================
# Social AI — Environment Variables
# ============================================================================
# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it contains secrets.
# ============================================================================


# ----------------------------------------------------------------------------
# Required — the app will refuse to start without these
# ----------------------------------------------------------------------------

# Neon Postgres connection string
# Get from: Neon dashboard → Connection Details → Connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Resend API key for sending magic link emails
# Get from: resend.com → API Keys
AUTH_RESEND_KEY=re_your_key_here

# NextAuth session signing secret — signs session cookies
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-secret-here

# Bearer token for Vercel Cron job authentication
# Vercel injects Authorization: Bearer <CRON_SECRET> on cron requests
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Claude API key for post generation
# Get from: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-your-key-here


# ----------------------------------------------------------------------------
# Optional — have sensible defaults; override as needed
# ----------------------------------------------------------------------------

# Public app URL used when composing links (emails, redirects)
# Default: http://localhost:3000
# Production: https://your-domain.com (set in Vercel project settings)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Sender email address for outgoing emails
# Default: onboarding@resend.dev (Resend sandbox)
# Production: use your verified domain, e.g. noreply@socialai.nl
EMAIL_FROM=onboarding@resend.dev

# Admin notification email — receives system alerts
# Default: "" (no admin notifications)
ADMIN_EMAIL=admin@example.com


# ----------------------------------------------------------------------------
# Meta (Facebook + Instagram) — used by the publisher OAuth flow
# ----------------------------------------------------------------------------

# Public app ID from developers.facebook.com → Settings → Basic
# Default: "" (Meta features disabled)
META_APP_ID=

# Server-only app secret — rotate immediately if exposed
# Get from: developers.facebook.com → Settings → Basic → App Secret
# Default: ""
META_APP_SECRET=

# Exact callback URL registered in Meta App → Facebook Login for Business
# Must match what's configured in the Meta developer console
# Local dev: http://localhost:3000/api/meta/callback
# Production: https://<your-domain>/api/meta/callback
# Default: ""
META_OAUTH_REDIRECT_URI=http://localhost:3000/api/meta/callback

# 32-byte AES-256-GCM key, base64-encoded — encrypts stored Meta access tokens
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NEVER commit a real value
# Default: ""
META_TOKEN_ENCRYPTION_KEY=

# Meta Graph API version
# Default: v21.0
META_GRAPH_VERSION=v21.0


# ----------------------------------------------------------------------------
# Storage — file/blob storage for uploaded images
# ----------------------------------------------------------------------------

# Vercel Blob read/write token
# Get from: Vercel dashboard → Storage → Blob → Tokens
# Default: "" (blob uploads disabled)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxx
